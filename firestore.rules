rules_version = '2';
// =============================================================================
// Firestore セキュリティルール
// -----------------------------------------------------------------------------
// 現在 Firebase コンソールは「テストモード」（誰でも読み書き可・期限付き）に
// なっています。本番（懇親会当日）の前に、このルールをデプロイして差し替えて
// ください。匿名ログイン済みのユーザーのみ読み書きを許可します。
//
//   デプロイ: npx firebase deploy --only firestore:rules
//
// ※ 主催者と参加者を厳密に分離するには Cloud Functions やカスタムクレームが
//    必要ですが、Spark プラン・社内の懇親会用途では「認証済みのみ許可」で
//    十分実用的です。
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
