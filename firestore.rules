rules_version = '2';
// =============================================================================
// Firestore セキュリティルール（アカウントごとに分離）
// -----------------------------------------------------------------------------
// 認可モデル：
//   - ログイン：Google アカウントがあれば誰でも（作成可）
//   - 各クイズ event は ownerUid(作成者) を持つ。編集・進行は
//     「オーナー本人」または「editors に招待されたメール」のみ
//   - 参加者(匿名)はルームコードを知っていれば問題・テーブル等を読み、回答できる
//   - 正解(keys)はオーナー/共同編集者のみ読める
//   - クイズ履歴 users/{uid} は本人のみ読み書き
//
//   デプロイ: npx firebase deploy --only firestore:rules
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function emailLower() { return request.auth.token.email.lower(); }

    // 個人のクイズ履歴（本人のみ）
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 対象イベントのオーナー/共同編集者か（サブコレクション用に親 event を参照）
    function evData(eid) {
      return get(/databases/$(database)/documents/events/$(eid)).data;
    }
    function canEdit(eid) {
      return signedIn()
        && exists(/databases/$(database)/documents/events/$(eid))
        && (
          evData(eid).ownerUid == request.auth.uid
          || ( verifiedEmail()
               && evData(eid).editors is list
               && (emailLower() in evData(eid).editors) )
        );
    }

    match /events/{eventId} {
      // 読みは参加者(匿名含む)も可。書きはオーナー/共同編集者のみ。
      allow read: if signedIn();
      allow create: if verifiedEmail()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.ownerUid == resource.data.ownerUid   // オーナー固定
        && (
          resource.data.ownerUid == request.auth.uid
          || ( verifiedEmail()
               && resource.data.editors is list
               && (emailLower() in resource.data.editors) )
        );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // 問題文・選択肢：読みは全員、編集はオーナー/共同編集者
      match /questions/{q} {
        allow read: if signedIn();
        allow write: if canEdit(eventId);
      }
      // 正解キー：オーナー/共同編集者のみ
      match /keys/{k} {
        allow read, write: if canEdit(eventId);
      }
      // テーブル：読みは全員。作成/削除は編集者、確保(update)は参加者も可
      match /tables/{t} {
        allow read: if signedIn();
        allow create, delete: if canEdit(eventId);
        allow update: if signedIn();
      }
      // 回答：作成は参加者本人、更新は採点前の本人 or 編集者、削除は編集者
      match /answers/{a} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.correct == null;
        allow update: if canEdit(eventId)
          || ( signedIn()
               && resource.data.uid == request.auth.uid
               && resource.data.correct == null
               && request.resource.data.uid == request.auth.uid );
        allow delete: if canEdit(eventId);
      }
    }
  }
}
