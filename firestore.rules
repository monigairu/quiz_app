rules_version = '2';
// =============================================================================
// Firestore セキュリティルール
// -----------------------------------------------------------------------------
// 認可モデル（メールアドレスはコード・ルールに一切ハードコードしません）：
//   - 管理者リストは meta/admins ドキュメントの emails 配列で管理（owner を含む）
//   - 管理者本人だけが meta/admins を読める（メール一覧を一般公開しない）
//   - 主催者(作問・進行)・正解(keys)の読み書きは管理者のみ
//   - 参加者(代表者)は匿名ログイン。読み取りと、自分の回答・テーブル確保のみ
//
// 初回セットアップ：
//   オーナーがホスト画面で Google ログイン →「オーナーとして登録」を押すと、
//   meta/admins が未作成のときに限り、自分を唯一のオーナーとして登録できます。
//   URL を配布する前に必ずオーナー登録を済ませてください（先着で確定するため）。
//
//   デプロイ: npx firebase deploy --only firestore:rules
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function emailLower() { return request.auth.token.email.lower(); }

    function adminsExist() {
      return exists(/databases/$(database)/documents/meta/admins);
    }
    function adminEmails() {
      return get(/databases/$(database)/documents/meta/admins).data.emails;
    }
    function isAdmin() {
      return verifiedEmail() && adminsExist() && (emailLower() in adminEmails());
    }

    // 管理者リスト（オーナー＋共同作成者）
    match /meta/admins {
      // 読めるのは「リストに載っている本人」だけ（＝管理者判定にも使う）
      allow read: if verifiedEmail() && (emailLower() in resource.data.emails);
      // 初回作成：未作成のときだけ、自分を唯一のオーナーとして登録できる
      allow create: if verifiedEmail()
        && request.resource.data.owner == emailLower()
        && request.resource.data.emails == [emailLower()];
      // 変更：既存の管理者のみ。オーナーは固定・保持必須
      allow update: if isAdmin()
        && request.resource.data.owner == resource.data.owner
        && (resource.data.owner in request.resource.data.emails);
      allow delete: if false;
    }

    match /events/{eventId} {
      // イベント本体：読みは参加者も可、書きは管理者のみ
      allow read: if signedIn();
      allow write: if isAdmin();

      // 問題文・選択肢：読みは全員、編集は管理者のみ
      match /questions/{q} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
      // 正解キー：管理者のみ（参加者には見えない）
      match /keys/{k} {
        allow read, write: if isAdmin();
      }
      // テーブル：読みは全員。作成/削除は管理者、確保(update)は参加者も可
      match /tables/{t} {
        allow read: if signedIn();
        allow create, delete: if isAdmin();
        allow update: if signedIn();
      }
      // 回答：読みは全員。作成は参加者本人。
      //   更新は「採点前の自分の回答（選び直し）」または管理者（採点）。
      //   削除は管理者のみ（得点リセット）。
      match /answers/{a} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.correct == null;
        allow update: if isAdmin()
          || ( signedIn()
               && resource.data.uid == request.auth.uid
               && resource.data.correct == null
               && request.resource.data.uid == request.auth.uid );
        allow delete: if isAdmin();
      }
    }
  }
}
